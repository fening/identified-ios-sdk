/* Consent (Consent.tsx) */
"consent.title" = "Consent & privacy";
"consent.subtitle" = "To verify your identity, %@ uses Identified to collect and check the information below.";
"consent.brand_fallback" = "this business";
"consent.learn_more" = "Learn more";
"consent.show_less" = "Show less";
"consent.collect.title" = "What we collect";
"consent.collect.liveness" = ", a short liveness check (turning your head)";
"consent.collect.tail" = ", and the details you enter.";
"consent.collect.none" = "The details you enter.";
"consent.collect.more1" = "Each document is captured in this flow and stored encrypted. We keep the image, the details read from it, and a record of when you submitted it.";
"consent.collect.more2" = "The details you enter — your name, date of birth and ID number — are compared against what your document says. A mismatch is flagged for a person to look at, not treated as fraud.";
"consent.collect.more3" = "Your proof of address needs to be a utility bill, bank statement or equivalent from the last 3 months showing your name and address.";
"consent.biometric.title" = "Biometric data";
"consent.biometric.body" = "Your selfie and liveness images confirm that you are a real, live person and that your face matches the photo on your ID.";
"consent.biometric.more1" = "The liveness check is a short movement prompt. It distinguishes a live person from a photo, a mask or a screen replay.";
"consent.biometric.more2" = "Face match compares your selfie to the photo on your ID and produces a similarity score. It is not used to search for you in any other database, and we do not run face recognition against the public internet.";
"consent.biometric.more3" = "Biometric data is treated as a special category of personal data everywhere we operate, which is why it is asked for separately here and processed only for this verification.";
"consent.background.title" = "Background screening";
"consent.background.body" = "We screen you against published sanctions and watchlists, verify any licence you hold with the authority that issued it, and carry out criminal-record screening.";
"consent.background.more1" = "Sanctions screening matches your name and date of birth against the published OFAC, United Nations and European Union consolidated lists. A hit is a possible match, not a finding — a person reviews it before anything is reported.";
"consent.background.more2" = "Licence verification checks the licence number and its status directly with the issuing authority.";
"consent.background.more3" = "Criminal-record screening is carried out manually by a trained operator, who records the evidence behind the result so it can be explained or challenged later.";
"consent.background.more4" = "Your proof of address establishes where you live, which is what makes a name match meaningful rather than a coincidence.";
"consent.background.more5" = "Identity verification and background screening are decided separately. Your identity result is issued as soon as it is ready and is never reversed automatically by a later screening finding.";
"consent.review.title" = "Human review";
"consent.review.body" = "A trained reviewer at Identified may look at what you submitted before a result is issued.";
"consent.review.more1" = "Most cases are decided automatically. A case goes to a person when the automated checks disagree with each other, when an image is unclear, or when screening returns something that needs judgement.";
"consent.review.more2" = "A reviewer sees your documents, your selfie and the check results. They do not see why you are being verified.";
"consent.review.more3" = "An adverse screening finding always goes to a person. Nothing about your result changes on the strength of an unreviewed match.";
"consent.review.more4" = "If a result was reached automatically, you can ask %@ to have a person review it.";
"consent.use.title" = "How it’s used";
"consent.use.body" = "Only to verify your identity%@ for %@. The result of the check is shared with %@.";
"consent.use.and_background" = " and background";
"consent.use.more1" = "%@ receives the outcome, the reasons behind it, and the documents you submitted for this verification.";
"consent.use.more2" = "Identified is a service of Fentord Technologies Limited, a company registered in Ghana. It runs the checks and stores the evidence on behalf of the business that sent you here, and does not use your data for its own purposes.";
"consent.use.more3" = "We never sell your data and never use it for advertising or profiling.";
"consent.protection.title" = "Data protection";
"consent.protection.body" = "Your data is encrypted in transit and at rest, and processed under the data-protection law of the country you are verified in.";
"consent.protection.more1" = "Identified operates across Africa, so the law that applies is the one where you are — for example Ghana’s Data Protection Act 2012, Nigeria’s Data Protection Act 2023, Kenya’s Data Protection Act 2019 or South Africa’s POPIA — alongside the African Union’s Malabo Convention. The GDPR applies where you or your data are in the EU or UK.";
"consent.protection.more2" = "Those regimes agree on the part that matters here: background screening needs your consent, and that consent has to be evidenced. This screen is that evidence — your agreement is recorded against your session with a version and a timestamp, on our side rather than in your browser.";
"consent.protection.more3" = "Every connection uses TLS, and your documents and images are stored encrypted. What that does not mean is that nobody here can ever see them: deciding a case sometimes needs a person to look at a document, so access is restricted and logged rather than impossible. Anyone claiming end-to-end encryption for a check a human may review is overstating it.";
"consent.protection.more4" = "You can complain to the Data Protection Commission or equivalent supervisory authority in your country at any time.";
"consent.retention.title" = "Retention";
"consent.retention.body" = "Your ID images and selfies are deleted a year after the check finishes, and the rest of the record after five years, unless deleted sooner.";
"consent.retention.more1" = "Until the images are deleted, they are kept with the case so the result can be explained or challenged. After that, only the details read from your documents and the decision remain.";
"consent.retention.more2" = "%@ can have Identified delete everything about you sooner, for example when you close your account with them. %@ may also keep its own copy of the result under its own policy; ask %@ about that.";
"consent.retention.more3" = "A verification you start but do not finish is deleted after 30 days.";
"consent.rights.title" = "Your rights";
"consent.rights.body" = "Providing this data is voluntary, but verification can’t continue without it.";
"consent.rights.more1" = "You can ask %@ for a copy of what was collected, ask for it to be corrected or deleted, or withdraw your consent.";
"consent.rights.more2" = "Identified holds your data for %@, so a request to delete it goes to %@, which decides and has Identified erase it. If you can sign in to the Identified verification portal, you can send that request from there.";
"consent.rights.more3" = "Withdrawing consent stops further processing. It does not undo a check that has already run, or a result already sent.";
"consent.rights.more4" = "Contact %@ to exercise any of these. If you are not satisfied, you can go to your country’s data-protection authority.";
